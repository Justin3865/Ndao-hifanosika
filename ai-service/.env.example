# Service IA (FastAPI) — variables d'environnement
AI_SERVICE_KEY=REMPLACER_PAR_LA_MEME_CLE_QUE_LE_BACKEND
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/ndao

# Synthèse narrative par LLM (OPTIONNEL). Sans ces deux variables, le texte est produit par règles (toujours disponible).
# Le texte du LLM est rejeté si un chiffre n'existe pas dans l'analyse (garde-fou « aucun chiffre inventé »).
# LLM_API_KEY=
# LLM_MODEL=
# LLM_API_URL=https://api.anthropic.com/v1/messages
