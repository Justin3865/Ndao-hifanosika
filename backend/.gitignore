# =====================================================
# .gitignore unique - Ndao Hifanosika
# À placer à la racine : C:\ndao-hifanosika\.gitignore
# (valable pour frontend, backend, ai-service, ml-service)
# =====================================================

# ---------- Dépendances ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Environnement et secrets ----------
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# ---------- Next.js (frontend) ----------
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.vercel

# ---------- Backend (Node / TypeScript / Prisma) ----------
dist/
**/generated/prisma/
.cache/
uploads/

# ---------- Python (ai-service, ml-service) ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Tests et couverture ----------
coverage/
.coverage
htmlcov/

# ---------- Journaux ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Système (Windows / macOS) ----------
desktop.ini
Thumbs.db
.DS_Store
# ---------- Sauvegardes locales et résidus (ajouté lot 20261109) ----------
*.bak
*.bak-*
*.backup
.test-build/
resultat.txt
