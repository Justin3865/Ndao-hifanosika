# Copiez ce fichier vers .env et complétez les valeurs localement.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ndao_hifanosika?schema=public
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG
JWT_REFRESH_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_LONG
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# E-mail de réinitialisation (Resend)
RESEND_API_KEY=
RESET_EMAIL_FROM=Ndao Hifanosika <noreply@example.org>
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- SMS (Twilio, optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Organisation (page d'accueil / carte). ORG_LAT/ORG_LNG : laisser vide si une zone "siège" est définie ---
ORG_NAME=Ndao Hifanosika
ORG_ADDRESS=
ORG_LAT=
ORG_LNG=

# --- Micro-services Python (optionnels : le backend fonctionne sans, avec ses modèles natifs) ---
# Ports recommandés : frontend 3000 -> backend 4000 -> ai-service 8000 / ml-service 8001 -> PostgreSQL 5432
AI_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
# Clé partagée backend <-> ml-service (même valeur dans l'environnement du ml-service)
AI_SERVICE_KEY=changez-moi-par-une-longue-valeur-aleatoire

# --- File d'attente (optionnelle) : sans REDIS_URL, file en mémoire (rien à installer) ---
# REDIS_URL=redis://localhost:6379
# QUEUE_CONCURRENCY=2

# --- Performance : seuil (ms) au-delà duquel une requête est journalisée comme « lente » (cahier : 500) ---
# PERF_SLOW_MS=500

# --- Lot C : sécurité (toutes optionnelles ; sans elles le comportement reste celui d'avant) ---
# Production : COORDINATOR_SCOPE=strict, FORCE_HTTPS=1 et TRUST_PROXY=1 (derrière le proxy TLS)
# COORDINATOR_SCOPE=strict
# FORCE_HTTPS=1
# TRUST_PROXY=1
# Limitation globale du débit par IP (défaut : 1200 requêtes / 60 s)
# RATE_LIMIT_MAX=1200
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=1
# Refuser le démarrage en production tant qu'un point de sécurité critique subsiste
# SECURITY_STRICT_STARTUP=1
# Autoriser volontairement le seed en production (déconseillé : il efface les données)
# ALLOW_SEED_IN_PRODUCTION=1
# Chiffrement (voir docs/SECURITE_LOT_C.md) : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY=
# DATA_INDEX_KEY=
