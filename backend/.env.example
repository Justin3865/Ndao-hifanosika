# Copiez ce fichier vers .env et complétez les valeurs localement.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ndao_hifanosika?schema=public
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG
JWT_REFRESH_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_LONG
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# E-mail de réinitialisation (Resend)
RESEND_API_KEY=
RESET_EMAIL_FROM=Ndao Hifanosika <noreply@example.org>
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
