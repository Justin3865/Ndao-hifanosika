generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum UserRole {
  ADMIN
  DIRECTION
  DSI
  DAF
  RH
  COMMUNICATION
  COORDINATOR
  TUTEUR_L3
  TUTEUR_M2
  STAGIAIRE_L3
  STAGIAIRE_M2
  STAGIAIRE_L1
  STAGIAIRE_L2
  STAGIAIRE_M1
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  VALIDATED
}

enum InternshipStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PartnerType {
  FUNDING_PARTNER
  IMPLEMENTING_PARTNER
  TECHNICAL_PARTNER
  INSTITUTIONAL_PARTNER
  OTHER
}

enum InternshipTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

model User {
  memberObjectives MemberObjective[]
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  phone     String?
  gender    Gender?

  birthDate  DateTime?
  birthPlace String?

  // ▼▼▼ AJOUTÉ : CIN (carte d'identité nationale) : numéro, délivrance, duplicata ▼▼▼
  cinNumber      String?
  cinIssuedAt    DateTime?
  cinIssuedPlace String?
  cinDuplicata   Boolean   @default(false)
  cinDuplicataAt DateTime?
  /// Niveau libre d'un stagiaire (option « Autre » du formulaire de stage) ; null pour L3 / M2
  studentLevel   String?
  // ▲▲▲

  /// Matricule du stagiaire (N° d'inscription, ex. NH-2026-STG-0001) : fixe, repris comme N° de ses certificats de stage
  matricule String? @unique

  /// Matricule du coordinateur / agent de terrain (NH-AAAA-AGT-0001), attribué à sa première mission
  agentMatricule String? @unique

  /// Niveau libre d'un tuteur ajouté avec « Autre » (ex. « Doctorat », « Expert »)
  tutorLevel String?

  role         UserRole   @default(STAGIAIRE_L3)
  status       UserStatus @default(PENDING)
  departmentId Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  avatarUrl    String?

  notifyEmail Boolean @default(true)
  notifySms   Boolean @default(true)

  // ▼▼▼ AJOUTÉ : double authentification (TOTP) + réglages du compte ▼▼▼
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])
  settings             Json?
  // ▲▲▲

  latitude          Float?
  longitude         Float?
  altitude          Float?
  locationUpdatedAt DateTime?
  sharingLocation   Boolean   @default(false)

  department Department? @relation(fields: [departmentId], references: [id])

  projectsCreated    Project[]    @relation("ProjectCreator")
  activitiesCreated  Activity[]   @relation("ActivityCreator")
  evaluationsCreated Evaluation[] @relation("EvaluationCreator")

  internships           Internship[] @relation("InternshipStudent")
  supervisedInternships Internship[] @relation("InternshipSupervisor")

  internshipApplications InternshipApplication[]

  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]           @relation("NotificationRecipient")
  sentNotifications     Notification[]           @relation("NotificationSender")
  notificationFiles     NotificationAttachment[] @relation("AttachmentUploader")
  pushSubscriptions     PushSubscription[]       @relation("UserPushSubscriptions")
  missions              Mission[]                @relation("MissionAgent")
  scheduledMessages     ScheduledMessage[]       @relation("ScheduledSender")
  surveys               Survey[]                 @relation("SurveyAgent")
  internshipEvaluations InternshipEvaluation[]   @relation("InternshipEvaluator")
  responsibleIndicators ProjectIndicator[]       @relation("IndicatorResponsible")
  preference            UserPreference?          @relation("UserPreferenceOwner")
  twoFactor             UserTwoFactor?           @relation("UserTwoFactorOwner")

  @@index([departmentId])
  @@index([role])
  @@index([status])
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  code        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    Project[]
  internships Internship[]

  @@index([name])
}

model Project {
  id                Int           @id @default(autoincrement())
  name              String
  code              String        @unique
  description       String?
  objective         String?
  /// Slogan du projet : imprimé sur les certificats des bénéficiaires
  slogan            String?
  startDate         DateTime?
  endDate           DateTime?
  status            ProjectStatus @default(DRAFT)
  budget            Decimal?      @db.Decimal(15, 2)
  budgetSpent       Decimal?      @db.Decimal(15, 2)
  beneficiaryTarget Int?
  departmentId      Int?
  createdById       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  createdBy  User        @relation("ProjectCreator", fields: [createdById], references: [id])

  activities          Activity[]
  milestones          Milestone[]
  evaluations         Evaluation[]
  beneficiaries       Beneficiary[]
  internships         Internship[]
  internshipLinks     InternshipProject[]
  objectives          ProjectObjective[]
  partnerLinks        ProjectPartner[]
  monitoringSnapshots ProjectMonitoringSnapshot[]
  certificates        Certificate[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
}

model Activity {
  id          Int            @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      ActivityStatus @default(PLANNED)
  budget      Decimal?       @db.Decimal(15, 2)
  budgetSpent Decimal?       @db.Decimal(15, 2)
  /// Avancement réel 0-100 (S&E) ; le statut en est déduit automatiquement
  progress        Int       @default(0)
  actualStartDate DateTime?
  actualEndDate   DateTime?
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ActivityCreator", fields: [createdById], references: [id])
  attendances    BeneficiaryAttendance[]
  attendanceLogs AttendanceLog[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Milestone {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Beneficiary {
  id         Int     @id @default(autoincrement())
  projectId  Int
  firstName  String
  lastName   String
  gender     Gender?
  age        Int?
  phone      String?
  email      String?
  vulnerable Boolean @default(false)

  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  lastSeenAt       DateTime?
  trackingToken    String?   @unique
  trackingEnabled  Boolean   @default(false)
  consentAt        DateTime?

  altitude Float?
  zoneId   Int?

  locality       String?

  // Localisation administrative du ménage (province > région > district > commune > fokontany)
  // + adresse exacte saisie à la main (lot, hameau / « zanabohitra »).
  // zoneUnits = sélection allégée (sans géométrie) pour la restaurer sur la carte.
  adminProvince  String?
  adminRegion    String?
  adminDistrict  String?
  adminCommune   String?
  adminFokontany String?
  addressDetail  String?
  zoneUnits      String? @db.Text

  homeLatitude   Float?
  homeLongitude  Float?
  homeAltitude   Float?
  householdSize  Int?
  monthlyIncome  Float?
  childrenUnder5 Int?
  hasDisability  Boolean @default(false)
  // Types de handicap du ménage (codes séparés par des virgules : MOTOR,VISUAL,…)
  disabilityTypes String?

  // Identité complète (naissance + CIN) : colonnes créées par la migration 20261030010000_identite_beneficiaires
  birthDate      DateTime?
  birthPlace     String?
  cinNumber      String?
  cinIssuedAt    DateTime?
  cinIssuedPlace String?
  cinDuplicata   Boolean   @default(false)
  cinDuplicataAt DateTime?

  /// Matricule automatique NH-AAAA-BEN-0001 (modifiable, unique)
  matricule String? @unique

  /// Données d'enquête du ménage (formulaire commun avec l'enquête de mission)
  outOfSchoolChildren Int?
  mealsPerDay         Int?
  healthIssues        Boolean?
  waterAccess         Boolean?
  electricityAccess   Boolean?
  housingType         String?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone         Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  surveys      Survey[]
  partnerLinks BeneficiaryPartner[]
  certificates Certificate[]
  followUps    PostProgramFollowUp[]
  attendances  BeneficiaryAttendance[]
  consent      BeneficiaryConsent?

  @@index([projectId])
  @@index([gender])
  @@index([zoneId])
}

model Evaluation {
  id          Int              @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  score       Float?
  status      EvaluationStatus @default(DRAFT)
  evaluatedAt DateTime?
  createdById Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // ▼▼▼ NOVOAKO : Nampiana ny altitude ▼▼▼
  altitude Float?
  // ▲▲▲

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("EvaluationCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Internship {
  documents InternshipDocument[]
  id           Int              @id @default(autoincrement())
  projectId    Int?
  studentId    Int
  supervisorId Int?
  /// Tuteur saisi librement (option « Autre » du formulaire) quand il n'a pas de compte ; null si supervisorId est renseigné
  supervisorName String?
  title        String
  institution  String?
  startDate    DateTime
  endDate      DateTime?
  status       InternshipStatus @default(PENDING)
  description  String?
  /// Thème du stage (sujet du stagiaire) : imprimé sur le certificat et suivi par le S&E
  theme        String?
  /// Département d'affectation du stagiaire (ex. « Suivi et Évaluation »)
  departmentId Int?
  /// Durée prévue (mois) pour le calcul de la présence : L3 = 2, M2 = 6, autre = saisie libre. NULL = ancien calcul.
  durationMonths Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project     Project?               @relation(fields: [projectId], references: [id])
  department  Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  student     User                   @relation("InternshipStudent", fields: [studentId], references: [id])
  supervisor  User?                  @relation("InternshipSupervisor", fields: [supervisorId], references: [id])
  tasks       InternshipTask[]
  evaluations InternshipEvaluation[]
  /// Tous les projets auxquels le stagiaire est rattaché (projectId = projet principal, le premier coché)
  projectLinks InternshipProject[]

  @@index([projectId])
  @@index([studentId])
  @@index([supervisorId])
  @@index([status])
  @@index([departmentId])
}

/// Rattachement d'un stage (stagiaire) à un ou plusieurs projets
model InternshipProject {
  internshipId Int
  projectId    Int
  createdAt    DateTime @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([internshipId, projectId])
  @@index([projectId])
}

model InternshipOffer {
  id          Int       @id @default(autoincrement())
  title       String
  domain      String?
  location    String?
  duration    String?
  deadline    DateTime?
  places      Int?
  description String    @db.Text
  isActive    Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications InternshipApplication[]

  @@index([isActive])
  @@index([createdAt])
}

model InternshipApplication {
  id         Int               @id @default(autoincrement())
  offerId    Int
  // Candidature publique : le compte est facultatif
  userId     Int?
  applicantName  String?
  applicantEmail String?
  phone      String?
  school     String?
  level      String?
  motivation String            @db.Text
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())

  // Dossier joint par le candidat + numéro de dossier
  dossierNumber String? @unique
  fileName      String?
  fileMime      String?
  fileSize      Int?
  fileData      Bytes?

  offer InternshipOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  files InternshipApplicationFile[]

  @@unique([offerId, userId])
  @@unique([offerId, applicantEmail])
  @@index([offerId])
  @@index([userId])
  @@index([status])
}

model InternshipApplicationFile {
  id            Int      @id @default(autoincrement())
  applicationId Int
  fileName      String
  fileMime      String
  fileSize      Int
  fileData      Bytes
  createdAt     DateTime @default(now())

  application InternshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RevokedRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int
  senderId   Int?
  replyToId  Int?
  title      String
  message    String
  type       NotificationType @default(INFO)
  read       Boolean          @default(false)
  archived   Boolean          @default(false)
  batchId    String?
  groupSize  Int?
  receivedAt DateTime?
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  createdAt  DateTime         @default(now())

  user        User                     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender      User?                    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo     Notification?            @relation("NotificationReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Notification[]           @relation("NotificationReplies")
  attachments NotificationAttachment[]

  @@index([userId, read])
  @@index([userId, senderId])
  @@index([userId, archived])
  @@index([batchId])
  @@index([createdAt])
}

model NotificationAttachment {
  id         Int      @id @default(autoincrement())
  uploaderId Int
  name       String
  mime       String
  kind       String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  notifications Notification[]
  scheduled     ScheduledMessage[] @relation("ScheduledAttachments")
  uploader      User               @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
}

// Abonnement Web Push d'un appareil (PC / téléphone) pour recevoir les notifications même application fermée.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Zone {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  region         String?
  latitude       Float
  longitude      Float
  radiusKm       Float?
  address        String?
  level          String?
  boundary       String?  @db.Text
  phone          String?
  email          String?
  isHeadquarters Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  beneficiaries Beneficiary[]
}

model Certificate {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  holderName  String
  holderEmail String?
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  holderBirthDate  DateTime?
  holderBirthPlace String?
  missionLocation  String?

  /// Mention de fin de stage et note finale /20 (calculée par le suivi & évaluation)
  mention    String?
  finalScore Float?

  /// Thème du stage + département, figés à la délivrance
  /// (« a effectué avec sérieux son stage dans le département : X intitulé « thème » »)
  theme          String?
  departmentName String?

  // ▼▼▼ AJOUTÉ : identité complémentaire (CIN) + cas particulier ▼▼▼
  holderPhone          String?
  holderCin            String?
  holderCinIssuedAt    DateTime?
  holderCinIssuedPlace String?
  holderCinDuplicata   Boolean   @default(false)
  holderCinDuplicataAt DateTime?
  specialCase          Boolean   @default(false)
  specialCaseNote      String?
  // ▲▲▲

  /// Slogan du projet figé à la délivrance (reste identique même si le projet change)
  slogan String?
  /// Slogan de chaque projet (nom + slogan), figé à la délivrance : affiché sous le nom du projet
  projectSlogans Json?

  internshipId  Int?
  projectId     Int?
  beneficiaryId Int?
  userId        Int?

  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  beneficiary  Beneficiary?         @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  partnerLinks CertificatePartner[]
  issuedById   Int?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String
  type        PartnerType @default(OTHER)
  slogan      String?
  logoUrl     String?
  website     String?
  description String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  projects      ProjectPartner[]
  beneficiaries BeneficiaryPartner[]
  certificates  CertificatePartner[]

  @@index([type])
  @@index([isActive])
}

model ProjectPartner {
  id           Int       @id @default(autoincrement())
  projectId    Int
  partnerId    Int
  role         String?
  contribution String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([projectId, partnerId])
  @@index([projectId])
  @@index([partnerId])
}

model BeneficiaryPartner {
  id            Int       @id @default(autoincrement())
  beneficiaryId Int
  partnerId     Int
  role          String?
  supportType   String?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, partnerId])
  @@index([beneficiaryId])
  @@index([partnerId])
}

model ProjectObjective {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results ProjectResult[]

  @@index([projectId, order])
}

model ProjectResult {
  id          Int      @id @default(autoincrement())
  objectiveId Int
  title       String
  description String?
  progress    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objective  ProjectObjective   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  indicators ProjectIndicator[]

  @@index([objectiveId, order])
}

model ProjectIndicator {
  id              Int       @id @default(autoincrement())
  resultId        Int
  name            String
  description     String?
  unit            String?
  baseline        Float?
  target          Float?
  currentValue    Float?
  source          String?
  frequency       String?
  responsibleId   Int?
  lastCollectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  measurements IndicatorMeasurement[]
  result      ProjectResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  responsible User?         @relation("IndicatorResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([resultId])
  @@index([responsibleId])
}

/// Historique des collectes d'un indicateur (valeur mesurée à une date donnée)
model IndicatorMeasurement {
  id            Int      @id @default(autoincrement())
  indicatorId   Int
  value         Float
  collectedAt   DateTime @default(now())
  collectedById Int?
  note          String?
  createdAt     DateTime @default(now())

  indicator ProjectIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId, collectedAt])
}

model ProjectMonitoringSnapshot {
  id              Int      @id @default(autoincrement())
  projectId       Int
  plannedProgress Int
  actualProgress  Int
  gap             Int
  recordedAt      DateTime @default(now())
  note            String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
}

model InternshipTask {
  id           Int                  @id @default(autoincrement())
  internshipId Int
  title        String
  description  String?
  status       InternshipTaskStatus @default(TODO)
  progress     Int                  @default(0)
  dueDate      DateTime?
  completedAt  DateTime?
  report       String?              @db.Text
  evidenceName String?
  evidenceMime String?
  evidenceSize Int?
  evidenceData Bytes?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
  @@index([status])
}

model InternshipEvaluation {
  id                 Int       @id @default(autoincrement())
  internshipId       Int
  evaluatorId        Int
  title              String
  technicalScore     Float?
  qualityScore       Float?
  autonomyScore      Float?
  punctualityScore   Float?
  communicationScore Float?
  overallScore       Float?
  comments           String?   @db.Text
  evaluatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  evaluator  User       @relation("InternshipEvaluator", fields: [evaluatorId], references: [id])

  @@index([internshipId])
  @@index([evaluatorId])
}

model CertificatePartner {
  id             Int     @id @default(autoincrement())
  certificateId  Int
  partnerId      Int
  role           String?
  displayOrder   Int     @default(0)
  nameSnapshot   String
  sloganSnapshot String?
  logoSnapshot   String?

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([partnerId])
}

model AiModel {
  id         Int      @id @default(autoincrement())
  name       String
  kind       String
  sampleSize Int
  metrics    Json
  weights    Json
  trainedAt  DateTime @default(now())
}

model EvaluationGrid {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  criteria    Json     @default("[]")
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EvaluationCampaign {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  gridId      Int?
  projectId   Int?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("DRAFT")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Mission terrain : démarrée et terminée PAR L'AGENT (elle survit aux changements de page)
model Mission {
  /// Matricule automatique NH-AAAA-MIS-0001 (unique)
  code String? @unique
  id         Int       @id @default(autoincrement())
  agentId    Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  distanceKm Float     @default(0)
  endReason  String?

  agent   User           @relation("MissionAgent", fields: [agentId], references: [id], onDelete: Cascade)
  points  MissionPoint[]
  surveys Survey[]

  @@index([agentId])
  @@index([startedAt])
  @@index([endedAt])
}

model MissionPoint {
  id        Int      @id @default(autoincrement())
  missionId Int
  latitude  Float
  longitude Float
  altitude  Float?
  accuracy  Float?
  heading   Float?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([createdAt])
}

/// Enquête ménage réalisée par un agent PENDANT une mission (jeu de données d'entraînement du modèle)
model Survey {
  /// Matricule automatique NH-AAAA-ENQ-0001 (unique)
  code                String?  @unique
  id                  Int      @id @default(autoincrement())
  beneficiaryId       Int
  agentId             Int
  missionId           Int?
  latitude            Float?
  longitude           Float?
  altitude            Float?
  householdSize       Int?
  monthlyIncome       Float?
  childrenUnder5      Int?
  outOfSchoolChildren Int?
  mealsPerDay         Int?
  hasDisability       Boolean  @default(false)
  healthIssues        Boolean?
  waterAccess         Boolean?
  electricityAccess   Boolean?
  housingType         String?
  vulnerable          Boolean  @default(false)
  notes               String?
  /// Début / fin de l'enquête (détection d'anomalies : durée, hors mission…)
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  agent       User        @relation("SurveyAgent", fields: [agentId], references: [id], onDelete: Cascade)
  mission     Mission?    @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([beneficiaryId, createdAt])
  @@index([agentId])
  @@index([missionId])
}

/// Message programmé : envoyé automatiquement à la date choisie (destinataires résolus au moment de l'envoi)
model ScheduledMessage {
  id             Int       @id @default(autoincrement())
  senderId       Int
  audience       Json
  title          String
  message        String
  type           String    @default("INFO")
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  scheduledAt    DateTime
  /// PENDING | SENDING | SENT | FAILED | CANCELLED
  status         String    @default("PENDING")
  error          String?
  recipientCount Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  sender      User                     @relation("ScheduledSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments NotificationAttachment[] @relation("ScheduledAttachments")

  @@index([status, scheduledAt])
  @@index([senderId])
}

/// Participation d'un stagiaire à une activité (demande, décision, rapport, preuve, présence, note du tuteur)
model ActivityParticipation {
  id          Int       @id @default(autoincrement())
  activityId  Int
  userId      Int
  status      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message     String?
  decidedById Int?
  decidedAt   DateTime?

  report    String?   @db.Text
  reportAt  DateTime?
  proofName String?
  proofMime String?
  proofSize Int?
  proofData Bytes?

  checkedInAt      DateTime?
  checkInLatitude  Float?
  checkInLongitude Float?

  rating        Int?
  ratingComment String?
  ratedById     Int?
  ratedAt       DateTime?

  remindedStartAt  DateTime?
  remindedReportAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, userId])
  @@index([userId])
  @@index([activityId])
  @@index([status])
}

/// Commentaires / questions sur une activité
model ActivityComment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([activityId, createdAt])
  @@index([userId])
}

/// Historique de l'ordre de mérite : une ligne par stagiaire et par période clôturée
model MeritSnapshot {
  id         Int      @id @default(autoincrement())
  period     String
  userId     Int
  level      String
  rank       Int
  cohortSize Int
  score      Float
  badge      String?
  details    Json?
  closedById Int?
  createdAt  DateTime @default(now())

  @@unique([period, userId])
  @@index([period])
  @@index([userId])
}

/// Paramètres personnels (page « Paramètres »), synchronisés sur tous les appareils
model UserPreference {
  userId              Int      @id
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  evaluationReminders Boolean  @default(true)
  projectReminders    Boolean  @default(true)
  reportReminders     Boolean  @default(true)
  sessionTimeout      Int      @default(30)
  theme               String   @default("Système")
  compactMode         Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation("UserPreferenceOwner", fields: [userId], references: [id], onDelete: Cascade)
}

/// Authentification à deux facteurs TOTP (clé chiffrée AES-256-GCM, codes de secours hachés)
model UserTwoFactor {
  userId       Int       @id
  secret       String
  enabled      Boolean   @default(false)
  enabledAt    DateTime?
  backupCodes  Json      @default("[]")
  lastUsedStep Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation("UserTwoFactorOwner", fields: [userId], references: [id], onDelete: Cascade)
}

/// Rappels déjà envoyés (évite d'envoyer deux fois le même rappel)
model ReminderLog {
  id     Int      @id @default(autoincrement())
  key    String   @unique
  kind   String
  sentAt DateTime @default(now())

  @@index([sentAt])
}

// Action prise sur une anomalie IA (clé stable "TYPE:entityId"), partagée par toute l'équipe.
model AnomalyAction {
  id           Int       @id @default(autoincrement())
  key          String    @unique
  type         String
  title        String
  status       String // IN_PROGRESS | RESOLVED | IGNORED
  note         String?
  snoozedUntil DateTime? // IGNORED temporaire : l'anomalie revient après cette date
  userId       Int?
  userName     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

/// Fahafaham-po (satisfaction) recueillie auprès des partenaires et des bénéficiaires d'un projet.
/// Chaque ligne = un questionnaire rempli ; `ratings` = { critère: note 1-5 } ; `score` = moyenne sur 5.
model ProjectFeedback {
  id            Int      @id @default(autoincrement())
  projectId     Int
  /// PARTNER | BENEFICIARY
  kind          String
  partnerId     Int?
  beneficiaryId Int?
  /// Nom de la personne interrogée (représentant du partenaire, bénéficiaire anonyme…)
  respondent    String?
  ratings       Json
  score         Float
  comment       String?  @db.Text
  collectedById Int?
  collectedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([projectId, kind])
  @@index([partnerId])
  @@index([beneficiaryId])
}

/// Suivi post-programme : relances à 3, 6 et 12 mois après la fin du parcours (cahier des charges §5.4)
enum FollowUpStatus {
  PENDING
  DONE
  MISSED
}

enum FollowUpOccupation {
  EMPLOYED
  SELF_EMPLOYED
  IN_TRAINING
  SEEKING
  INACTIVE
}

model PostProgramFollowUp {
  id            Int            @id @default(autoincrement())
  beneficiaryId Int
  /// 3, 6 ou 12 (mois après la fin du programme)
  horizonMonths Int
  dueDate       DateTime
  status        FollowUpStatus @default(PENDING)
  completedAt   DateTime?

  occupation     FollowUpOccupation?
  activityCreated Boolean?
  monthlyIncome  Float?
  /// Satisfaction 1 à 5
  satisfaction   Int?
  notes          String?  @db.Text
  completedById  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, horizonMonths])
  @@index([status, dueDate])
}

// ── Lot 20261108 : statut du parcours + affectation des coordinateurs ──────────
// Modèles autonomes (clés étrangères en SQL, sans relation Prisma) pour ne rien
// modifier dans Beneficiary / Project / User.
enum JourneyStatus {
  ACTIVE
  COMPLETED
  DROPPED_OUT
}

model BeneficiaryJourney {
  id            Int           @id @default(autoincrement())
  beneficiaryId Int           @unique
  status        JourneyStatus @default(ACTIVE)
  statusDate    DateTime?
  dropoutReason String?       @db.Text
  recordedById  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model ProjectCoordinator {
  id           Int      @id @default(autoincrement())
  projectId    Int
  userId       Int
  assignedById Int?
  createdAt    DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// Journal horodaté (à la seconde) des enregistrements et suppressions de pointages.
model AttendanceLog {
  id            Int      @id @default(autoincrement())
  activityId    Int
  /// SAVE | DELETE
  action        String
  /// nombre de pointages concernés
  count         Int      @default(0)
  beneficiaryId Int?
  userId        Int?
  userName      String?
  createdAt     DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
}

/// Présence d'un bénéficiaire à une séance (§5.4). updatedAt = date/heure/seconde du dernier pointage.
model BeneficiaryAttendance {
  id            Int      @id @default(autoincrement())
  activityId    Int
  beneficiaryId Int
  present       Boolean  @default(true)
  note          String?
  recordedById  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  activity    Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([activityId, beneficiaryId])
  @@index([beneficiaryId])
}

/// Objectifs individuels / KPI RH d'un membre (§5.3)
model MemberObjective {
  id           Int       @id @default(autoincrement())
  userId       Int
  title        String
  description  String?
  kpi          String?
  unit         String?
  targetValue  Float?
  currentValue Float?
  dueDate      DateTime?
  status       String    @default("PLANNED")
  projectId    Int?
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Documents de stage : convention, rapport, mémoire (§5.3)
model InternshipDocument {
  id           Int      @id @default(autoincrement())
  internshipId Int
  kind         String
  name         String
  mime         String
  size         Int
  data         Bytes
  note         String?
  uploadedById Int?
  createdAt    DateTime @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

/// Consentement du tuteur légal d'un bénéficiaire mineur (§10)
model BeneficiaryConsent {
  id               Int       @id @default(autoincrement())
  beneficiaryId    Int       @unique
  guardianName     String
  guardianRelation String?
  guardianContact  String?
  scope            String?
  consentAt        DateTime
  revokedAt        DateTime?
  recordedById     Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

// ── Lot 20261113 (P1 · A1–A3) : notes par bénéficiaire, scores IA, rattachement N-N ──
// Modèles autonomes (clés étrangères en SQL, sans relation Prisma) pour ne rien
// modifier dans Beneficiary / Project / Evaluation / User. Aucun code existant
// ne les lit ni ne les écrit encore : ajout purement additif.

/// A1 · Note d'un bénéficiaire pour une évaluation (échelle par défaut /20, comme le modèle de risque).
/// Sert de série temporelle (evaluatedAt) pour la tendance et pour la moyenne d'évaluation.
model EvaluationScore {
  id            Int      @id @default(autoincrement())
  evaluationId  Int
  beneficiaryId Int
  score         Float
  maxScore      Float    @default(20)
  comment       String?
  recordedById  Int?
  evaluatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([evaluationId, beneficiaryId])
  @@index([beneficiaryId, evaluatedAt])
  @@map("evaluation_scores")
}

/// A2 · Historique des scores IA (risque d'abandon, etc.) : un enregistrement par calcul.
model AiScore {
  id            Int      @id @default(autoincrement())
  beneficiaryId Int
  projectId     Int?
  /// DROPOUT_RISK (d'autres types pourront s'ajouter sans migration)
  kind          String   @default("DROPOUT_RISK")
  /// 0–100
  score         Float
  /// LOW | MEDIUM | HIGH
  level         String
  /// ml-logreg-v1 | rules-v1 | …
  model         String
  /// variables d'entrée utilisées (taux de présence, moyenne, etc.)
  features      Json?
  computedAt    DateTime @default(now())

  @@index([beneficiaryId, kind, computedAt])
  @@index([projectId, kind])
  @@map("ai_scores")
}

/// A3 · Rattachement N-N bénéficiaire ↔ projet. Beneficiary.projectId reste le projet principal
/// (inchangé) ; cette table est reprise depuis lui et permet les rattachements supplémentaires.
model BeneficiaryProject {
  beneficiaryId Int
  projectId     Int
  /// ACTIVE | COMPLETED | DROPPED_OUT
  status        String   @default("ACTIVE")
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@id([beneficiaryId, projectId])
  @@index([projectId])
  @@map("beneficiaries_projects")
}

/// Sélection des bénéficiaires : critères d'éligibilité d'un projet. Le quota est Project.beneficiaryTarget.
model EnrollmentRule {
  projectId         Int      @id
  enabled           Boolean  @default(true)
  /// true : les candidats retenus deviennent bénéficiaires automatiquement
  autoEnroll        Boolean  @default(true)
  /// score IA de départ (0-100) : on retient d'abord les ménages ayant au moins ce score
  topScore          Int      @default(70)
  /// score IA plancher (0-100) : tant que le quota n'est pas atteint, le seuil descend par paliers de 5 jusqu'à ce plancher (baissable ensuite à la main, de 5 en 5)
  minScore          Int      @default(50)
  /// FEMALE | MALE | null (tous)
  gender            String?
  ageMin            Int?
  ageMax            Int?
  maxMonthlyIncome  Float?
  minHouseholdSize  Int?
  minChildrenUnder5 Int?
  requireDisability Boolean  @default(false)
  requireVulnerable Boolean  @default(false)
  localityContains  String?
  updatedById       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("enrollment_rules")
}

/// Ménage enquêté pendant une mission qui n'est pas (encore) bénéficiaire.
/// PENDING | WAITLIST | NOT_ELIGIBLE | ENROLLED (ENROLLED = devenu bénéficiaire, voir beneficiaryId)
model EnrollmentCandidate {
  id                  Int       @id @default(autoincrement())
  /// Matricule de l'ENQUÊTE NH-AAAA-ENQ-0001 (le matricule bénéficiaire NH-AAAA-BEN-xxxxxxx n'est attribué qu'à la sélection)
  code                String?   @unique
  firstName           String
  lastName            String
  gender              Gender?
  age                 Int?
  phone               String?
  locality            String?
  adminCommune        String?
  adminFokontany      String?
  addressDetail       String?
  email               String?
  birthDate           DateTime?
  birthPlace          String?
  cinNumber           String?
  cinIssuedAt         DateTime?
  cinIssuedPlace      String?
  cinDuplicata        Boolean   @default(false)
  adminProvince       String?
  adminRegion         String?
  adminDistrict       String?
  zoneUnits           String?
  disabilityTypes     String?
  latitude            Float?
  longitude           Float?
  altitude            Float?
  householdSize       Int?
  monthlyIncome       Float?
  childrenUnder5      Int?
  outOfSchoolChildren Int?
  mealsPerDay         Int?
  hasDisability       Boolean   @default(false)
  healthIssues        Boolean?
  waterAccess         Boolean?
  electricityAccess   Boolean?
  housingType         String?
  vulnerable          Boolean   @default(false)
  notes               String?
  agentId             Int
  /// Matricule (NH-AAAA-AGT-0001) de l'agent qui a réalisé l'enquête, figé à la saisie
  agentMatricule      String?
  missionId           Int?
  startedAt           DateTime?
  endedAt             DateTime?
  /// Projet visé par l'agent (facultatif : sinon tous les projets avec critères sont envisagés)
  projectId           Int?
  status              String    @default("PENDING")
  score               Float?
  scoreMethod         String?
  scoredAt            DateTime?
  /// { at, projectId, reasons[], score } : justification de la dernière décision
  decision            Json?
  waitlistProjectId   Int?
  waitlistRank        Int?
  enrolledProjectId   Int?
  beneficiaryId       Int?
  enrolledAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([agentId])
  @@index([projectId])
  @@index([enrolledProjectId])
  @@index([missionId])
  @@map("enrollment_candidates")
}

/// Pointage journalier GPS (stagiaires, coordinateurs, direction…) : arrivée vérifiée + départ avec les tâches faites ce jour-là
model DailyPresence {
  id           Int     @id @default(autoincrement())
  userId       Int
  /// Jour local YYYY-MM-DD (heure de Madagascar)
  day          String
  /// SIEGE (au siège de l'ONG) | TERRAIN (en mission / sur le terrain)
  mode         String  @default("SIEGE")
  internshipId Int?
  projectId    Int?
  /// Mission « présence » (ou mission en cours) rattachée : alimente le calcul de présence du suivi & évaluation
  missionId    Int?

  checkInAt          DateTime
  inLatitude         Float
  inLongitude        Float
  inAltitude         Float?
  inAccuracy         Float?
  inZoneId           Int?
  inDistanceM        Float?
  inExpectedAltitude Float?

  checkOutAt   DateTime?
  outLatitude  Float?
  outLongitude Float?
  outAltitude  Float?
  outAccuracy  Float?
  outDistanceM Float?

  /// OK | SUSPECT
  status    String   @default("OK")
  /// Codes d'anomalie (OUT_OF_ZONE, ALTITUDE_MISMATCH, LEFT_SITE…)
  flags     Json?
  tasksDone Int      @default(0)
  summary   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks DailyPresenceTask[]

  @@unique([userId, day])
  @@index([day])
  @@index([internshipId])
  @@index([projectId])
  @@map("daily_presences")
}

/// Tâches déclarées à la fin de la journée (alimentent InternshipTask : avancement, rapport)
model DailyPresenceTask {
  id               Int      @id @default(autoincrement())
  presenceId       Int
  internshipTaskId Int?
  /// Activité du projet mise à jour (tâche d'un membre qui n'est pas stagiaire) : alimente l'avancement du projet
  activityId       Int?
  title            String
  note             String?  @db.Text
  /// Avancement (%) de la tâche en fin de journée
  progress         Int?
  completed        Boolean  @default(false)
  createdAt        DateTime @default(now())

  presence DailyPresence @relation(fields: [presenceId], references: [id], onDelete: Cascade)

  @@index([presenceId])
  @@index([internshipTaskId])
  @@index([activityId])
  @@map("daily_presence_tasks")
}
