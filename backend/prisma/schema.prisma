generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum UserRole {
  ADMIN
  DIRECTION
  DSI
  DAF
  RH
  COMMUNICATION
  COORDINATOR
  TUTEUR_L3
  TUTEUR_M2
  STAGIAIRE_L3
  STAGIAIRE_M2
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  VALIDATED
}

enum InternshipStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 Int        @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String     @unique
  password           String
  phone              String?
  gender             Gender?
  
  birthDate          DateTime?
  birthPlace         String?

  role               UserRole   @default(STAGIAIRE_L3)
  status             UserStatus @default(PENDING)
  departmentId       Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  avatarUrl          String?

  notifyEmail        Boolean    @default(true)
  notifySms          Boolean    @default(true)

  latitude           Float?
  longitude          Float?
  altitude           Float?
  locationUpdatedAt  DateTime?
  sharingLocation    Boolean    @default(false)

  department         Department? @relation(fields: [departmentId], references: [id])

  projectsCreated    Project[]  @relation("ProjectCreator")
  activitiesCreated  Activity[] @relation("ActivityCreator")
  evaluationsCreated Evaluation[] @relation("EvaluationCreator")

  internships        Internship[] @relation("InternshipStudent")
  supervisedInternships Internship[] @relation("InternshipSupervisor")

  internshipApplications InternshipApplication[]

  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[] @relation("NotificationRecipient")
  sentNotifications   Notification[] @relation("NotificationSender")
  notificationFiles   NotificationAttachment[] @relation("AttachmentUploader")
  pushSubscriptions   PushSubscription[] @relation("UserPushSubscriptions")
  missions            Mission[]  @relation("MissionAgent")
  scheduledMessages   ScheduledMessage[] @relation("ScheduledSender")
  surveys             Survey[]   @relation("SurveyAgent")

  @@index([departmentId])
  @@index([role])
  @@index([status])
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  code        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    Project[]

  @@index([name])
}

model Project {
  id             Int           @id @default(autoincrement())
  name           String
  code           String        @unique
  description    String?
  objective      String?
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(DRAFT)
  budget         Decimal?      @db.Decimal(15, 2)
  beneficiaryTarget Int?
  departmentId   Int?
  createdById    Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  department     Department?   @relation(fields: [departmentId], references: [id])
  createdBy      User          @relation("ProjectCreator", fields: [createdById], references: [id])

  activities     Activity[]
  milestones     Milestone[]
  evaluations    Evaluation[]
  beneficiaries  Beneficiary[]
  internships    Internship[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
}

model Activity {
  id          Int            @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      ActivityStatus @default(PLANNED)
  budget      Decimal?       @db.Decimal(15, 2)
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Milestone {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Beneficiary {
  id          Int      @id @default(autoincrement())
  projectId   Int
  firstName   String
  lastName    String
  gender      Gender?
  age         Int?
  phone       String?
  email       String?
  vulnerable  Boolean  @default(false)

  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  lastSeenAt       DateTime?
  trackingToken    String?   @unique
  trackingEnabled  Boolean   @default(false)
  consentAt        DateTime?

  altitude    Float?
  zoneId      Int?

  locality       String?
  homeLatitude   Float?
  homeLongitude  Float?
  homeAltitude   Float?
  householdSize  Int?
  monthlyIncome  Float?
  childrenUnder5 Int?
  hasDisability  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone        Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  surveys     Survey[]

  @@index([projectId])
  @@index([gender])
  @@index([zoneId])
}

model Evaluation {
  id          Int              @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  score       Float?
  status      EvaluationStatus @default(DRAFT)
  evaluatedAt DateTime?
  createdById Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // ▼▼▼ NOVOAKO : Nampiana ny altitude ▼▼▼
  altitude    Float?
  // ▲▲▲

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("EvaluationCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Internship {
  id             Int              @id @default(autoincrement())
  projectId      Int?
  studentId      Int
  supervisorId   Int?
  title          String
  institution    String?
  startDate      DateTime
  endDate        DateTime?
  status         InternshipStatus @default(PENDING)
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project        Project?         @relation(fields: [projectId], references: [id])
  student        User             @relation("InternshipStudent", fields: [studentId], references: [id])
  supervisor     User?            @relation("InternshipSupervisor", fields: [supervisorId], references: [id])

  @@index([projectId])
  @@index([studentId])
  @@index([supervisorId])
  @@index([status])
}

model InternshipOffer {
  id          Int       @id @default(autoincrement())
  title       String
  domain      String?
  location    String?
  duration    String?
  deadline    DateTime?
  places      Int?
  description String    @db.Text
  isActive    Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications InternshipApplication[]

  @@index([isActive])
  @@index([createdAt])
}

model InternshipApplication {
  id         Int               @id @default(autoincrement())
  offerId    Int
  userId     Int
  phone      String?
  school     String?
  level      String?
  motivation String            @db.Text
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())

  offer      InternshipOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([offerId])
  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entity     String?
  entityId   Int?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RevokedRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  senderId  Int?
  replyToId Int?
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  archived  Boolean          @default(false)
  batchId   String?
  groupSize Int?
  receivedAt DateTime?
  latitude  Float?
  longitude Float?
  accuracy  Float?
  createdAt DateTime         @default(now())

  user        User                     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender      User?                    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo     Notification?            @relation("NotificationReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Notification[]           @relation("NotificationReplies")
  attachments NotificationAttachment[]

  @@index([userId, read])
  @@index([userId, senderId])
  @@index([userId, archived])
  @@index([batchId])
  @@index([createdAt])
}

model NotificationAttachment {
  id            Int      @id @default(autoincrement())
  uploaderId    Int
  name          String
  mime          String
  kind          String
  size          Int
  data          Bytes
  createdAt     DateTime @default(now())

  notifications Notification[]
  scheduled     ScheduledMessage[] @relation("ScheduledAttachments")
  uploader      User           @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
}

// Abonnement Web Push d'un appareil (PC / téléphone) pour recevoir les notifications même application fermée.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Zone {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  region         String?
  latitude       Float
  longitude      Float
  radiusKm       Float?
  address        String?
  phone          String?
  email          String?
  isHeadquarters Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  beneficiaries  Beneficiary[]
}

model Certificate {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         String
  holderName   String
  holderEmail  String?
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  
  holderBirthDate DateTime?
  holderBirthPlace String?
  missionLocation String?

  internshipId Int?
  userId       Int?
  issuedById   Int?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model AiModel {
  id         Int      @id @default(autoincrement())
  name       String
  kind       String
  sampleSize Int
  metrics    Json
  weights    Json
  trainedAt  DateTime @default(now())
}

model EvaluationGrid {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  criteria    Json     @default("[]")
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EvaluationCampaign {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  gridId      Int?
  projectId   Int?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("DRAFT")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Mission terrain : démarrée et terminée PAR L'AGENT (elle survit aux changements de page)
model Mission {
  id         Int       @id @default(autoincrement())
  agentId    Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  distanceKm Float     @default(0)
  endReason  String?

  agent   User           @relation("MissionAgent", fields: [agentId], references: [id], onDelete: Cascade)
  points  MissionPoint[]
  surveys Survey[]

  @@index([agentId])
  @@index([startedAt])
  @@index([endedAt])
}

model MissionPoint {
  id        Int      @id @default(autoincrement())
  missionId Int
  latitude  Float
  longitude Float
  altitude  Float?
  accuracy  Float?
  heading   Float?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([createdAt])
}

/// Enquête ménage réalisée par un agent PENDANT une mission (jeu de données d'entraînement du modèle)
model Survey {
  id                  Int      @id @default(autoincrement())
  beneficiaryId       Int
  agentId             Int
  missionId           Int?
  latitude            Float?
  longitude           Float?
  altitude            Float?
  householdSize       Int?
  monthlyIncome       Float?
  childrenUnder5      Int?
  outOfSchoolChildren Int?
  mealsPerDay         Int?
  hasDisability       Boolean  @default(false)
  healthIssues        Boolean?
  waterAccess         Boolean?
  electricityAccess   Boolean?
  housingType         String?
  vulnerable          Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  agent       User        @relation("SurveyAgent", fields: [agentId], references: [id], onDelete: Cascade)
  mission     Mission?    @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([beneficiaryId, createdAt])
  @@index([agentId])
  @@index([missionId])
}

/// Message programmé : envoyé automatiquement à la date choisie (destinataires résolus au moment de l'envoi)
model ScheduledMessage {
  id             Int       @id @default(autoincrement())
  senderId       Int
  audience       Json
  title          String
  message        String
  type           String    @default("INFO")
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  scheduledAt    DateTime
  /// PENDING | SENDING | SENT | FAILED | CANCELLED
  status         String    @default("PENDING")
  error          String?
  recipientCount Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  sender      User                     @relation("ScheduledSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments NotificationAttachment[] @relation("ScheduledAttachments")

  @@index([status, scheduledAt])
  @@index([senderId])
}

/// Participation d'un stagiaire à une activité (demande, décision, rapport, preuve, présence, note du tuteur)
model ActivityParticipation {
  id               Int       @id @default(autoincrement())
  activityId       Int
  userId           Int
  status           String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message          String?
  decidedById      Int?
  decidedAt        DateTime?

  report           String?   @db.Text
  reportAt         DateTime?
  proofName        String?
  proofMime        String?
  proofSize        Int?
  proofData        Bytes?

  checkedInAt      DateTime?
  checkInLatitude  Float?
  checkInLongitude Float?

  rating           Int?
  ratingComment    String?
  ratedById        Int?
  ratedAt          DateTime?

  remindedStartAt  DateTime?
  remindedReportAt DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([activityId, userId])
  @@index([userId])
  @@index([activityId])
  @@index([status])
}

/// Commentaires / questions sur une activité
model ActivityComment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([activityId, createdAt])
  @@index([userId])
}

/// Historique de l'ordre de mérite : une ligne par stagiaire et par période clôturée
model MeritSnapshot {
  id         Int      @id @default(autoincrement())
  period     String
  userId     Int
  level      String
  rank       Int
  cohortSize Int
  score      Float
  badge      String?
  details    Json?
  closedById Int?
  createdAt  DateTime @default(now())

  @@unique([period, userId])
  @@index([period])
  @@index([userId])
}
