generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum UserRole {
  ADMIN
  DIRECTION
  DSI
  DAF
  RH
  COMMUNICATION
  COORDINATOR
  TUTEUR_L3
  TUTEUR_M2
  STAGIAIRE_L3
  STAGIAIRE_M2
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  VALIDATED
}

enum InternshipStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ▼▼▼ VAOVAO : statut d'une candidature à une offre de stage ▼▼▼
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 Int        @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String     @unique
  password           String
  phone              String?
  gender             Gender?
  role               UserRole   @default(STAGIAIRE_L3)
  status             UserStatus @default(PENDING)
  departmentId       Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  avatarUrl          String?

  // Préférences de notification
  notifyEmail        Boolean    @default(true)
  notifySms          Boolean    @default(true)

  // Position partagée par les agents (mission terrain)
  latitude           Float?
  longitude          Float?
  altitude           Float?
  locationUpdatedAt  DateTime?
  sharingLocation    Boolean    @default(false)

  department         Department? @relation(fields: [departmentId], references: [id])

  projectsCreated    Project[]  @relation("ProjectCreator")
  activitiesCreated  Activity[] @relation("ActivityCreator")
  evaluationsCreated Evaluation[] @relation("EvaluationCreator")

  internships        Internship[] @relation("InternshipStudent")
  supervisedInternships Internship[] @relation("InternshipSupervisor")

  // ▼ VAOVAO : candidatures de l'utilisateur aux offres de stage
  internshipApplications InternshipApplication[]

  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  @@index([departmentId])
  @@index([role])
  @@index([status])
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  code        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    Project[]

  @@index([name])
}

model Project {
  id             Int           @id @default(autoincrement())
  name           String
  code           String        @unique
  description    String?
  objective      String?
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(DRAFT)
  budget         Decimal?      @db.Decimal(15, 2)
  beneficiaryTarget Int?
  departmentId   Int?
  createdById    Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  department     Department?   @relation(fields: [departmentId], references: [id])
  createdBy      User          @relation("ProjectCreator", fields: [createdById], references: [id])

  activities     Activity[]
  milestones     Milestone[]
  evaluations    Evaluation[]
  beneficiaries  Beneficiary[]
  internships    Internship[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
}

model Activity {
  id          Int            @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      ActivityStatus @default(PLANNED)
  budget      Decimal?       @db.Decimal(15, 2)
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Milestone {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Beneficiary {
  id          Int      @id @default(autoincrement())
  projectId   Int
  firstName   String
  lastName    String
  gender      Gender?
  age         Int?
  phone       String?
  email       String?
  vulnerable  Boolean  @default(false)

  // Suivi terrain (position partagée avec consentement)
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  lastSeenAt       DateTime?
  trackingToken    String?   @unique
  trackingEnabled  Boolean   @default(false)
  consentAt        DateTime?

  // Zone d'intervention
  altitude    Float?
  zoneId      Int?

  // Domicile du ménage et indicateurs de vulnérabilité
  locality       String?
  homeLatitude   Float?
  homeLongitude  Float?
  homeAltitude   Float?
  householdSize  Int?
  monthlyIncome  Float?
  childrenUnder5 Int?
  hasDisability  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone        Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([gender])
  @@index([zoneId])
}

model Evaluation {
  id          Int              @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  score       Float?
  status      EvaluationStatus @default(DRAFT)
  evaluatedAt DateTime?
  createdById Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("EvaluationCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

model Internship {
  id             Int              @id @default(autoincrement())
  projectId      Int?
  studentId      Int
  supervisorId   Int?
  title          String
  institution    String?
  startDate      DateTime
  endDate        DateTime?
  status         InternshipStatus @default(PENDING)
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project        Project?         @relation(fields: [projectId], references: [id])
  student        User             @relation("InternshipStudent", fields: [studentId], references: [id])
  supervisor     User?            @relation("InternshipSupervisor", fields: [supervisorId], references: [id])

  @@index([projectId])
  @@index([studentId])
  @@index([supervisorId])
  @@index([status])
}

// ▼▼▼ VAOVAO : offres de stage publiées par l'admin ▼▼▼
model InternshipOffer {
  id          Int       @id @default(autoincrement())
  title       String
  domain      String?
  location    String?
  duration    String?
  deadline    DateTime?
  places      Int?
  description String    @db.Text
  isActive    Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications InternshipApplication[]

  @@index([isActive])
  @@index([createdAt])
}

// ▼▼▼ VAOVAO : candidatures des utilisateurs aux offres ▼▼▼
model InternshipApplication {
  id         Int               @id @default(autoincrement())
  offerId    Int
  userId     Int
  phone      String?
  school     String?
  level      String?
  motivation String            @db.Text
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())

  offer      InternshipOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([offerId])
  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entity     String?
  entityId   Int?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}


model RevokedRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}


model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}


model Zone {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  region         String?
  latitude       Float
  longitude      Float
  radiusKm       Float?
  address        String?
  phone          String?
  email          String?
  isHeadquarters Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  beneficiaries  Beneficiary[]
}


model Certificate {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         String
  holderName   String
  holderEmail  String?
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  internshipId Int?
  userId       Int?
  issuedById   Int?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}


model AiModel {
  id         Int      @id @default(autoincrement())
  name       String
  kind       String
  sampleSize Int
  metrics    Json
  weights    Json
  trainedAt  DateTime @default(now())
}


model EvaluationGrid {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  criteria    Json     @default("[]")
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model EvaluationCampaign {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  gridId      Int?
  projectId   Int?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("DRAFT")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
