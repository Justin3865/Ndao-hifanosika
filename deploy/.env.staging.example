# Copier vers .env.staging puis remplacer TOUS les « CHANGER_… ». Ne jamais versionner le fichier réel.
ENV_NAME=staging
NODE_ENV=staging
POSTGRES_DB=ndao
POSTGRES_USER=ndao
POSTGRES_PASSWORD=CHANGER_mot_de_passe_long
JWT_SECRET=CHANGER_secret_jwt_32_caracteres_minimum
JWT_REFRESH_SECRET=CHANGER_autre_secret_different
AI_SERVICE_KEY=CHANGER_cle_partagee_back_ia_ml
FRONTEND_URL=https://recette.exemple.org
CORS_ORIGIN=https://recette.exemple.org
NEXT_PUBLIC_API_URL=https://api-recette.exemple.org/api
BACK_PORT=4100
FRONT_PORT=3100
BACKUP_KEEP_DAYS=14
PERF_SLOW_MS=500
