# Copier vers .env.dev puis remplacer TOUS les « CHANGER_… ». Ne jamais versionner le fichier réel.
ENV_NAME=dev
NODE_ENV=development
POSTGRES_DB=ndao
POSTGRES_USER=ndao
POSTGRES_PASSWORD=CHANGER_mot_de_passe_long
JWT_SECRET=CHANGER_secret_jwt_32_caracteres_minimum
JWT_REFRESH_SECRET=CHANGER_autre_secret_different
AI_SERVICE_KEY=CHANGER_cle_partagee_back_ia_ml
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
BACK_PORT=4000
FRONT_PORT=3000
BACKUP_KEEP_DAYS=14
PERF_SLOW_MS=500
# REDIS_URL=redis://redis:6379   # + docker compose --profile queue up
# LLM_API_KEY=                   # optionnel : synthèses narratives via un LLM (sinon synthèse à règles)
