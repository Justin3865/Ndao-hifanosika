# Copier en .env.prod puis remplacer TOUTES les valeurs « CHANGER_… » (ne jamais committer le fichier réel).
NODE_ENV=production
POSTGRES_USER=ndao
POSTGRES_PASSWORD=CHANGER_mot_de_passe_postgres
POSTGRES_DB=ndao_prod
JWT_SECRET=CHANGER_secret_jwt_64_caracteres_aleatoires
JWT_REFRESH_SECRET=CHANGER_autre_secret_64_caracteres_aleatoires
TWO_FACTOR_KEY=CHANGER_cle_2fa_32_caracteres_minimum
AI_SERVICE_KEY=CHANGER_cle_service_ia
FRONTEND_URL=https://ndao-hifanosika.example.org
CORS_ORIGIN=https://ndao-hifanosika.example.org
NEXT_PUBLIC_API_URL=https://api.ndao-hifanosika.example.org/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Périmètre coordinateurs : « strict » = sans affectation, aucun accès (recommandé en production une fois les affectations faites)
COORDINATOR_SCOPE=strict
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14
SITE_DOMAIN=ndao-hifanosika.example.org
API_DOMAIN=api.ndao-hifanosika.example.org
ACME_EMAIL=CHANGER_admin@example.org
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# REDIS_URL=redis://redis:6379   (avec : docker compose --profile queue up)

# --- Anomalies de présence & note (optionnel ; valeurs par défaut sûres) ---
# Jours de fermeture propres à l'ONG (en plus des week-ends et jours fériés malgaches), séparés par des virgules
# NON_WORKING_DAYS_EXTRA=2026-12-24,2026-12-31
# Pénalité PROPOSÉE (sur 20) par cas confirmé, et plafond. Jamais appliquée automatiquement ; à valider par la RH.
# NOTE_ANOMALY_PENALTY_PER_CASE=0.25
# NOTE_ANOMALY_PENALTY_CAP=2

# --- LOT 3 : alerte RH « performance en baisse » et purge planifiée (optionnel) ---
# Alerte quotidienne (notifications RH/ADMIN uniquement) : active par défaut ; mettre false pour couper
# PERF_DROP_ALERTS=true
# Baisse relative qui déclenche l'alerte (0.2 = -20 % par rapport à la moyenne des 3 notes précédentes) et historique minimal
# PERF_DROP_RATIO=0.2
# PERF_DROP_MIN_PREVIOUS=2
# Purge quotidienne des journaux techniques (même périmètre que la purge manuelle ; jamais de données métier). DÉSACTIVÉE par défaut.
# À n'activer qu'après validation des durées de conservation par la Direction (LOT 11).
# RETENTION_AUTOPURGE=false
