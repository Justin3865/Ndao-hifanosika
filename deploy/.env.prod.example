# Copier vers .env.prod puis remplacer TOUS les « CHANGER_… ». Ne jamais versionner le fichier réel.
ENV_NAME=prod
NODE_ENV=production
POSTGRES_DB=ndao
POSTGRES_USER=ndao
POSTGRES_PASSWORD=CHANGER_mot_de_passe_long
JWT_SECRET=CHANGER_secret_jwt_32_caracteres_minimum
JWT_REFRESH_SECRET=CHANGER_autre_secret_different
AI_SERVICE_KEY=CHANGER_cle_partagee_back_ia_ml
FRONTEND_URL=https://suivi.exemple.org
CORS_ORIGIN=https://suivi.exemple.org
NEXT_PUBLIC_API_URL=https://api.exemple.org/api
BACK_PORT=4000
FRONT_PORT=3000
BACKUP_KEEP_DAYS=14
PERF_SLOW_MS=500
# REDIS_URL=redis://redis:6379   # + docker compose --profile queue up
# LLM_API_KEY=                   # optionnel : synthèses narratives via un LLM (sinon synthèse à règles)
# Production : domaines servis en HTTPS par Caddy
APP_DOMAIN=suivi.exemple.org
API_DOMAIN=api.exemple.org
